# Fichiers exclus du contexte de build de l'API

# Docker
Dockerfile
.dockerignore

# Git
.git
.gitignore

# Secrets : jamais dans une image
.env
.env.*

# Dépendances : réinstallées par npm ci dans l'image
node_modules/
npm-debug.log*

# Build et tests : regénérés dans l'image
dist/
coverage/

# PDF des règles : stockés dans le volume "regles", pas dans l'image
regles/

# IDE et système
.vscode/
.idea/
.DS_Store
*.log
