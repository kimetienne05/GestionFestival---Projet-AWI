# Fichiers exclus du contexte de build du front

# Docker
Dockerfile
.dockerignore

# Git
.git
.gitignore

# Secrets : jamais dans une image
.env
.env.*

# Dépendances : réinstallées par npm ci dans l'image
node_modules/
npm-debug.log*

# Cache et build Angular : regénérés dans l'image
.angular/
dist/
coverage/

# IDE et système
.vscode/
.idea/
.DS_Store
*.log
